{
  "info": {
    "name": "Tenax Prop — Mobile API v1",
    "_postman_id": "b7c1e2f0-0000-4000-a000-tenaxpropv1",
    "description": "Mobile REST API for the Tenax Prop app. Every response uses the envelope { success, message, data, errors, meta } (see api_standard.json). Auth: Laravel Sanctum bearer token.\n\nSetup:\n1. Select an environment (Dev/Prod) with variables: base_url, access_token, challenge_token.\n2. Run 'Auth > Login' — its Test script saves data.access_token into {{access_token}}.\n3. All protected requests inherit Authorization: Bearer {{access_token}} at collection level.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "variable": [
    { "key": "base_url", "value": "https://api.tenaxprop.com/api/v1" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Rahul\",\n  \"last_name\": \"Sharma\",\n  \"email\": \"rahul@example.com\",\n  \"password\": \"Secret@123\",\n  \"country_code\": \"IN\",\n  \"phone\": \"9876543210\",\n  \"device_name\": \"iphone-15\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth", "register"] }
          },
          "response": [
            {
              "name": "201 Created",
              "code": 201,
              "status": "Created",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": true,\n  \"message\": \"Account created successfully. Please verify your email.\",\n  \"data\": {\n    \"access_token\": \"1|abcdef...\",\n    \"token_type\": \"Bearer\",\n    \"user\": {\n      \"id\": \"100483\",\n      \"name\": \"Rahul Sharma\",\n      \"first_name\": \"Rahul\",\n      \"last_name\": \"Sharma\",\n      \"email\": \"rahul@example.com\",\n      \"phone\": \"+919876543210\",\n      \"country_code\": \"IN\",\n      \"email_verified\": false,\n      \"two_factor_enabled\": false,\n      \"created_at\": \"2026-08-31T10:15:30Z\"\n    }\n  },\n  \"errors\": null,\n  \"meta\": null\n}"
            },
            {
              "name": "422 Validation",
              "code": 422,
              "status": "Unprocessable Entity",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": false,\n  \"message\": \"The email has already been taken.\",\n  \"data\": null,\n  \"errors\": {\n    \"email\": [\"The email has already been taken.\"]\n  },\n  \"meta\": null\n}"
            }
          ]
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data.access_token) {",
                  "    pm.environment.set('access_token', res.data.access_token);",
                  "    pm.collectionVariables.set('access_token', res.data.access_token);",
                  "}",
                  "if (res && res.data && res.data.challenge_token) {",
                  "    pm.environment.set('challenge_token', res.data.challenge_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rahul@example.com\",\n  \"password\": \"Secret@123\",\n  \"device_name\": \"iphone-15\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          },
          "response": [
            {
              "name": "200 OK (no 2FA)",
              "code": 200,
              "status": "OK",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": true,\n  \"message\": \"Logged in successfully.\",\n  \"data\": {\n    \"access_token\": \"2|xyz...\",\n    \"token_type\": \"Bearer\",\n    \"user\": {\n      \"id\": \"100482\",\n      \"name\": \"Rahul Sharma\",\n      \"email\": \"rahul@example.com\",\n      \"email_verified\": true,\n      \"two_factor_enabled\": false\n    }\n  },\n  \"errors\": null,\n  \"meta\": null\n}"
            },
            {
              "name": "200 OK (2FA required)",
              "code": 200,
              "status": "OK",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": true,\n  \"message\": \"Two-factor verification required.\",\n  \"data\": {\n    \"two_factor_required\": true,\n    \"challenge_token\": \"3|challenge...\"\n  },\n  \"errors\": null,\n  \"meta\": null\n}"
            },
            {
              "name": "401 Bad credentials",
              "code": 401,
              "status": "Unauthorized",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": false,\n  \"message\": \"These credentials do not match our records.\",\n  \"data\": null,\n  \"errors\": null,\n  \"meta\": null\n}"
            }
          ]
        },
        {
          "name": "Two-Factor Verify",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data.access_token) {",
                  "    pm.environment.set('access_token', res.data.access_token);",
                  "    pm.collectionVariables.set('access_token', res.data.access_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{challenge_token}}", "type": "string" }] },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"123456\"\n}" },
            "url": { "raw": "{{base_url}}/auth/two-factor", "host": ["{{base_url}}"], "path": ["auth", "two-factor"] }
          },
          "response": []
        },
        {
          "name": "Forgot Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"rahul@example.com\"\n}" },
            "url": { "raw": "{{base_url}}/auth/forgot-password", "host": ["{{base_url}}"], "path": ["auth", "forgot-password"] }
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
