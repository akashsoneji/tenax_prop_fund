{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "sweetpad-lldb",
            "request": "launch",
            "name": "Build and Launch (SweetPad)",
            "preLaunchTask": "sweetpad: launch",
            "stopAll": true
        },
        {
            "type": "sweetpad-lldb",
            "request": "attach",
            "name": "Attach to Running App (SweetPad)",
            "description": "Use this if the app is already running to avoid rebuild"
        },
        {
            "name": "Tenax Prop — Debug",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "preLaunchTask": "prepare-ios-tenax",
            "args": [
                "--flavor",
                "tenax",
                "--dart-define-from-file=config/flavors/tenax.json",
                "--dart-define=ENV=development"
            ]
        },
        {
            "name": "Tenax Prop — Release",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "flutterMode": "release",
